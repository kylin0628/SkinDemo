<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TextView控件属性 -->
    <declare-styleable name="SkinnableTextView">
        <attr name="android:background" />
        <attr name="android:textColor" />
        <!-- 字体属性 -->
    </declare-styleable>

    <!-- Button控件继承TextView，此处parent语法通过，但无效果，不像style.xml -->
    <declare-styleable name="SkinnableButton">
        <attr name="android:background" />
        <attr name="android:textColor" />
        <!-- 字体属性 -->
    </declare-styleable>

    <!-- SkinnableEditText控件 -->
    <declare-styleable name="SkinnableEditText">
        <attr name="android:background" />
        <attr name="android:textColor" />
        <!-- 字体属性 -->
    </declare-styleable>

    <!-- ImageView控件特有属性 -->
    <declare-styleable name="SkinnableImageView">
        <attr name="android:src" />
    </declare-styleable>

    <!-- SkinnableLinearLayout控件 -->
    <declare-styleable name="SkinnableLinearLayout">
        <attr name="android:background" />
    </declare-styleable>

    <!-- SkinnableRelativeLayout控件 -->
    <declare-styleable name="SkinnableRelativeLayout">
        <attr name="android:background" />
    </declare-styleable>
    <!-- SkinnableNestedScrollView控件 -->
    <declare-styleable name="SkinnableNestedScrollView">
        <attr name="android:background" />
    </declare-styleable>
    <!-- SkinnableConstraintLayout -->
    <declare-styleable name="SkinnableConstraintLayout">
        <attr name="android:background" />
    </declare-styleable>
    <!-- SkinnableFrameLayout控件 -->
    <declare-styleable name="SkinnableFrameLayout">
        <attr name="android:background" />
    </declare-styleable>

    <!-- SkinnableScrollView控件 -->
    <declare-styleable name="SkinnableScrollView">
        <attr name="android:background" />
    </declare-styleable>

    <!-- SkinnableCardView控件 -->
    <declare-styleable name="SkinnableCardView">
        <attr name="android:background" />
    </declare-styleable>

    <!-- SkinnableImageButton控件 -->
    <declare-styleable name="SkinnableImageButton">
        <attr name="android:background" />
        <attr name="android:src" />
    </declare-styleable>

    <!-- SkinnableCheckBox控件 -->
    <declare-styleable name="SkinnableCheckBox">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

    <!-- SkinnableRadioButton控件 -->
    <declare-styleable name="SkinnableRadioButton">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

    <!-- SkinnableSwitchCompat控件 -->
    <declare-styleable name="SkinnableSwitchCompat">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

    <!-- SkinnableToggleButton控件 -->
    <declare-styleable name="SkinnableToggleButton">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

    <!-- SkinnableCheckedTextView控件 -->
    <declare-styleable name="SkinnableCheckedTextView">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

    <!-- SkinnableAutoCompleteTextView控件 -->
    <declare-styleable name="SkinnableAutoCompleteTextView">
        <attr name="android:background" />
        <attr name="android:textColor" />
    </declare-styleable>

</resources>