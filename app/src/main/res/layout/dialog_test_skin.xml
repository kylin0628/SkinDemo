<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/skin_item_color"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/skin_test_dialog_title"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/text_size_22"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@color/colorPrimary" />

    <!-- 描述 -->
    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/skin_test_dialog_desc"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/text_size_14"
        android:padding="8dp"
        android:background="@color/colorPrimaryDark" />

    <!-- 当前皮肤状态 -->
    <TextView
        android:id="@+id/tv_skin_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="当前：默认皮肤"
        android:textColor="@color/skin_item_color"
        android:textSize="@dimen/text_size_16"
        android:padding="12dp"
        android:background="@color/colorAccent" />

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 关闭 Dialog 按钮 -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/skin_btn_close"
            android:textColor="@color/skin_item_color"
            android:textSize="@dimen/text_size_16"
            android:background="@color/colorAccent" />

        <!-- 切换默认皮肤按钮 -->
        <Button
            android:id="@+id/btn_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/skin_btn_default_theme"
            android:textColor="@color/skin_item_color"
            android:textSize="@dimen/text_size_16"
            android:background="@color/colorAccent" />

    </LinearLayout>

    <!-- 切换动态皮肤按钮 -->
    <Button
        android:id="@+id/btn_dynamic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/skin_btn_switch_dynamic_theme"
        android:textColor="@color/skin_item_color"
        android:textSize="@dimen/text_size_16"
        android:background="@color/colorAccent" />

</LinearLayout>
