<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dialog_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_multi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="第 1 层弹框"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_18"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/skin_multi_level_desc"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_13" />

    <ListView
        android:id="@+id/lv_multi_list"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_next_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/main_style"
            android:text="@string/skin_btn_next_level"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

        <Button
            android:id="@+id/btn_nested_popup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/main_style"
            android:text="@string/skin_btn_popup"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

        <Button
            android:id="@+id/btn_nested_dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@color/main_style"
            android:text="@string/skin_btn_native_dialog_short"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_multi_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@color/colorAccent"
            android:text="@string/skin_btn_default_theme"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

        <Button
            android:id="@+id/btn_multi_dynamic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/colorAccent"
            android:text="@string/skin_btn_dynamic_theme"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

        <Button
            android:id="@+id/btn_multi_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@color/colorAccent"
            android:text="@string/skin_btn_close"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_13" />

    </LinearLayout>

</LinearLayout>
